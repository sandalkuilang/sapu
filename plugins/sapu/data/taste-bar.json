  "rules": [
    { "id": "scale.spacing", "family": "scale", "class": "derived", "metric": "distinct_spacing", "threshold": { "peer": [1.5, 3], "band": "p90" }, "cite": ["refactoring-ui", "primer", "carbon", "atlassian"], "gate": false },
    { "id": "scale.type", "family": "scale", "class": "derived", "metric": "distinct_type", "threshold": { "peer": [1.5, 3], "band": "p90" }, "cite": ["refactoring-ui", "geist"], "gate": false },
    { "id": "scale.weights", "family": "scale", "class": "derived", "metric": "distinct_weights", "threshold": { "peer": [1.5, 3], "band": "p90" }, "cite": ["refactoring-ui"], "gate": false },
    { "id": "scale.colours", "family": "scale", "class": "derived", "metric": "distinct_colours", "threshold": { "peer": [1.5, 3], "band": "p90" }, "cite": ["refactoring-ui", "radix"], "gate": false },
    { "id": "scale.radii", "family": "scale", "class": "derived", "metric": "distinct_radii", "threshold": { "peer": [1.5, 3], "band": "p90" }, "cite": ["m3-tokens", "primer"], "gate": false },
    { "id": "scale.shadows", "family": "scale", "class": "derived", "metric": "distinct_shadows", "threshold": { "peer": [1.5, 3], "band": "p90" }, "cite": ["refactoring-ui", "m3-tokens"], "gate": false },
    { "id": "scale.off-scale", "family": "scale", "class": "derived", "metric": "off_scale_values", "threshold": { "max": 0 }, "cite": ["primer", "carbon", "atlassian", "m3-tokens"], "gate": false },
    { "id": "hierarchy.primary-actions", "family": "hierarchy", "class": "bar", "metric": "primary_actions", "threshold": { "max": 1 }, "cite": ["m3-expressive", "lux-hick"], "gate": false },
    { "id": "hierarchy.heading-order", "family": "hierarchy", "class": "derived", "metric": "heading_inversions", "threshold": { "max": 0 }, "cite": ["refactoring-ui", "nng-heuristics"], "gate": false },
    { "id": "hierarchy.alignment", "family": "hierarchy", "class": "derived", "metric": "edge_offset_px", "threshold": { "within": [1, 3] }, "cite": ["apple-layout"], "gate": false },
    { "id": "hierarchy.section-gaps", "family": "hierarchy", "class": "derived", "metric": "off_scale_gaps", "threshold": { "max": 0 }, "cite": ["atlassian", "primer"], "gate": false },
    { "id": "hierarchy.shadow-layers", "family": "hierarchy", "class": "derived", "metric": "shadows_beyond_layers", "threshold": { "max": 0 }, "cite": ["atlassian", "m3-tokens", "apple-materials"], "gate": false },
    { "id": "hierarchy.nested-radius", "family": "hierarchy", "class": "implicit", "metric": "radius_inversions", "threshold": { "max": 0 }, "cite": ["vercel-wig", "apple-lg"], "gate": false },
    { "id": "colour.role", "family": "colour", "class": "derived", "metric": "role_values", "threshold": { "max": 1 }, "cite": ["radix", "shadcn", "linear-redesign", "stripe-color"], "gate": false },
    { "id": "colour.dark-contrast", "family": "colour", "class": "implicit", "metric": "dark_only_contrast_failures", "threshold": { "max": 0 }, "cite": ["apple-dark", "apple-a11y"], "gate": false },
    { "id": "colour.dark-border", "family": "colour", "class": "implicit", "metric": "collapsed_borders", "threshold": { "max": 0 }, "cite": ["apple-dark", "radix"], "gate": false },
    { "id": "colour.dark-surface", "family": "colour", "class": "implicit", "metric": "light_surfaces_on_dark", "threshold": { "max": 0 }, "cite": ["apple-dark", "shadcn"], "gate": false },
    { "id": "contrast.headroom", "family": "contrast", "class": "bar", "metric": "body_contrast_ratio", "threshold": { "min": 7 }, "cite": ["apple-dark"], "gate": false, "info": true },
    { "id": "motion.duration", "family": "motion", "class": "bar", "metric": "animation_ms", "threshold": { "range": [50, 500], "opacity_max": 700 }, "cite": ["atlassian", "carbon", "m3-tokens", "primer"], "gate": false },
    { "id": "motion.layout-property", "family": "motion", "class": "implicit", "metric": "layout_animations", "threshold": { "max": 0 }, "cite": ["webdev-animations", "webdev-cls"], "gate": false },
    { "id": "motion.transition-all", "family": "motion", "class": "bar", "metric": "transition_all", "threshold": { "max": 0 }, "cite": ["vercel-wig"], "gate": false, "info": true },
    { "id": "motion.reduced", "family": "motion", "class": "bar", "metric": "reduced_motion_transforms", "threshold": { "max": 0 }, "cite": ["wcag-233", "apple-a11y", "mdn-prefers"], "gate": false },
    { "id": "feedback.latency", "family": "feedback", "class": "bar", "metric": "first_change_ms", "threshold": { "max": 100 }, "cite": ["nng-response", "webdev-inp"], "gate": false, "info": true },
    { "id": "feedback.busy", "family": "feedback", "class": "implicit", "metric": "unsignalled_wait_ms", "threshold": { "max": 1000 }, "cite": ["nng-response", "nng-progress"], "gate": false },
    { "id": "feedback.progress", "family": "feedback", "class": "implicit", "metric": "indeterminate_wait_ms", "threshold": { "max": 10000 }, "cite": ["nng-response", "nng-skeleton"], "gate": false },
    { "id": "feedback.loader-flash", "family": "feedback", "class": "bar", "metric": "loader_shown_ms", "threshold": { "min": 300, "min_wait": 1000 }, "cite": ["vercel-wig", "nng-progress"], "gate": false },
    { "id": "feedback.skeleton-peers", "family": "feedback", "class": "derived", "metric": "spinner_wait_ms", "threshold": { "within": [1000, 10000] }, "cite": ["nng-skeleton", "carbon", "primer-patterns"], "gate": false },
    { "id": "feedback.skeleton-shift", "family": "feedback", "class": "implicit", "metric": "skeleton_shifts", "threshold": { "max": 0 }, "cite": ["vercel-wig"], "gate": false },
    { "id": "feedback.optimistic", "family": "feedback", "class": "derived", "metric": "late_optimistic_changes", "threshold": { "max": 0 }, "cite": ["vercel-wig"], "gate": false },
    { "id": "density.control-heights", "family": "density", "class": "derived", "metric": "control_heights", "threshold": { "max": 2 }, "cite": ["cloudscape-density", "primer"], "gate": false },
    { "id": "density.row-heights", "family": "density", "class": "derived", "metric": "table_row_heights", "threshold": { "max": 1 }, "cite": ["cloudscape-density"], "gate": false },
    { "id": "states.error", "family": "states", "class": "implicit", "metric": "dead_error_states", "threshold": { "max": 0 }, "cite": ["vercel-wig", "nng-errors"], "gate": false },
    { "id": "states.empty-next", "family": "states", "class": "bar", "metric": "empty_states_without_control", "threshold": { "max": 0 }, "cite": ["nng-empty", "carbon", "atlassian"], "gate": false },
    { "id": "states.success", "family": "states", "class": "implicit", "metric": "unnamed_success_ms", "threshold": { "max": 1000 }, "cite": ["nng-heuristics", "apple-genai"], "gate": false },
    { "id": "states.recovery", "family": "states", "class": "implicit", "metric": "fields_lost", "threshold": { "max": 0 }, "cite": ["nng-errors", "primer-patterns"], "gate": false },
    { "id": "states.error-exit", "family": "states", "class": "bar", "metric": "errors_without_exit", "threshold": { "max": 0 }, "cite": ["nng-errors", "atlassian"], "gate": false, "info": true },
    { "id": "copy.broken", "family": "copy", "class": "implicit", "metric": "broken_tokens", "threshold": { "max": 0 }, "cite": ["nng-errors"], "gate": false },
    { "id": "copy.vague", "family": "copy", "class": "bar", "metric": "vague_labels", "threshold": { "max": 0 }, "cite": ["atlassian", "vercel-wig"], "gate": false, "terms": { "en": ["OK", "Submit", "Continue", "Click here", "Yes", "No"] } },
    { "id": "consistent.action", "family": "consistent", "class": "derived", "metric": "controls_per_action", "threshold": { "max": 1 }, "cite": ["nng-consistency", "nng-heuristics"], "gate": false },
    { "id": "consistent.footer-order", "family": "consistent", "class": "derived", "metric": "primary_positions", "threshold": { "max": 1 }, "cite": ["nng-consistency"], "gate": false },
    { "id": "consistent.save-pattern", "family": "consistent", "class": "derived", "metric": "mixed_save_forms", "threshold": { "max": 0 }, "cite": ["primer-patterns"], "gate": false },
    { "id": "consistent.palette", "family": "consistent", "class": "derived", "metric": "palette_gaps", "threshold": { "max": 0 }, "cite": ["superhuman-cmdk", "nng-heuristics"], "gate": false },
    { "id": "ai.stop", "family": "ai", "class": "derived", "metric": "streams_without_stop", "threshold": { "max": 0 }, "cite": ["teams-streaming", "aisdk-chat"], "gate": false },
    { "id": "ai.error", "family": "ai", "class": "derived", "metric": "errors_without_way_on", "threshold": { "max": 0 }, "cite": ["aisdk-chat", "apple-genai"], "gate": false },
    { "id": "ai.regenerate", "family": "ai", "class": "derived", "metric": "answers_without_regenerate", "threshold": { "max": 0 }, "cite": ["aisdk-chat"], "gate": false },
    { "id": "efficiency.actions", "family": "efficiency", "class": "derived", "metric": "actions", "threshold": { "ratio": 3 }, "cite": ["klm"], "gate": false },
    { "id": "efficiency.klm", "family": "efficiency", "class": "derived", "metric": "klm_s", "threshold": { "plus_s": 10 }, "cite": ["klm", "fitts-mackenzie", "nng-fitts"], "gate": false }
